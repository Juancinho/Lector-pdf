<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later. Floating liquid-glass pen toolbar. It can be
     dragged by its grip, laid out horizontally or vertically and collapsed into a bubble.
     StudyPenToolbar swaps orientation-dependent sizes at runtime. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/studyToolbarPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_capsule"
        android:clipChildren="true"
        android:contentDescription="@string/study_pen_toolbar"
        android:elevation="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/studyGrip"
            android:layout_width="26dp"
            android:layout_height="64dp"
            android:alpha="0.45"
            android:contentDescription="@string/study_move_toolbar"
            android:scaleType="center"
            android:src="@drawable/ic_glass_grip" />

        <ImageButton
            android:id="@+id/studyToolRead"
            style="@style/StudyIconButton"
            android:contentDescription="@string/study_tool_read"
            android:src="@drawable/ic_glass_cursor" />

        <View
            android:id="@+id/studyDivider1"
            style="@style/StudyToolDivider" />

        <FrameLayout
            android:id="@+id/studyToolHighlighter"
            style="@style/StudyToolCell"
            android:contentDescription="@string/study_tool_highlighter">

            <ImageView
                android:id="@+id/studyToolHighlighterArt"
                android:importantForAccessibility="no"
                style="@style/StudyToolArt" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/studyToolPen"
            style="@style/StudyToolCell"
            android:contentDescription="@string/study_tool_pen">

            <ImageView
                android:id="@+id/studyToolPenArt"
                android:importantForAccessibility="no"
                style="@style/StudyToolArt" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/studyToolMarker"
            style="@style/StudyToolCell"
            android:contentDescription="@string/study_tool_marker">

            <ImageView
                android:id="@+id/studyToolMarkerArt"
                android:importantForAccessibility="no"
                style="@style/StudyToolArt" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/studyToolEraser"
            style="@style/StudyToolCell"
            android:contentDescription="@string/study_tool_eraser">

            <ImageView
                android:id="@+id/studyToolEraserArt"
                android:importantForAccessibility="no"
                style="@style/StudyToolArt" />
        </FrameLayout>

        <View
            android:id="@+id/studyDivider2"
            style="@style/StudyToolDivider" />

        <FrameLayout
            android:id="@+id/studyColorButton"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_tool"
            android:contentDescription="@string/study_tool_color"
            android:focusable="true">

            <View
                android:id="@+id/studyColorDot"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_study_color_dot"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <View
            android:id="@+id/studyDivider3"
            style="@style/StudyToolDivider" />

        <ImageButton
            android:id="@+id/studyUndoButton"
            style="@style/StudyIconButton"
            android:contentDescription="@string/study_undo"
            android:src="@drawable/ic_glass_undo" />

        <ImageButton
            android:id="@+id/studyRedoButton"
            style="@style/StudyIconButton"
            android:contentDescription="@string/study_redo"
            android:src="@drawable/ic_glass_redo" />

        <View
            android:id="@+id/studyDivider4"
            style="@style/StudyToolDivider" />

        <ImageButton
            android:id="@+id/studyCollapseButton"
            style="@style/StudyIconButton"
            android:contentDescription="@string/study_collapse_toolbar"
            android:src="@drawable/ic_glass_collapse" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/studyDoneButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_study_done"
                android:contentDescription="@string/study_done"
                android:scaleType="center"
                android:src="@drawable/ic_glass_check"
                app:tint="@color/study_surface" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/studyToolbarBubble"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_glass_bubble"
        android:clipChildren="true"
        android:contentDescription="@string/study_expand_toolbar"
        android:elevation="14dp"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/studyBubbleArt"
            android:layout_width="28dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:rotation="-40"
            android:translationY="4dp" />
    </FrameLayout>
</FrameLayout>
