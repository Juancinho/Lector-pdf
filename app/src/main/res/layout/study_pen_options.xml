<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later. Tool options, shown in a glass popover
     anchored to the floating toolbar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel_strong"
    android:clipToPadding="false"
    android:fadingEdgeLength="16dp"
    android:requiresFadingEdge="vertical"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/studyOptionsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:textColor="@color/study_ink"
            android:textSize="18sp"
            tools:text="Pen" />

        <TextView
            android:id="@+id/studyToolHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/study_muted"
            android:textSize="13sp"
            tools:text="Width follows pen pressure." />

        <LinearLayout
            android:id="@+id/studyColorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/StudySectionLabel"
                android:text="@string/study_section_color" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/studyColorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/studyWidthGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/StudySectionLabel"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1"
                    android:text="@string/study_width_label" />

                <TextView
                    android:id="@+id/studyWidthValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/study_muted"
                    android:textSize="13sp"
                    tools:text="1.6 pt" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/studyWidthSlider"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="-12dp"
                android:layout_marginEnd="-12dp"
                android:contentDescription="@string/study_width_label"
                android:stepSize="0.1"
                android:valueFrom="0.5"
                android:valueTo="6"
                app:haloRadius="16dp"
                app:labelBehavior="gone"
                app:thumbColor="@color/study_paper"
                app:thumbElevation="3dp"
                app:thumbHeight="24dp"
                app:thumbStrokeColor="@color/study_glass_outline"
                app:thumbStrokeWidth="0.75dp"
                app:thumbTrackGapSize="0dp"
                app:thumbWidth="24dp"
                app:tickVisible="false"
                app:trackStopIndicatorSize="0dp"
                app:trackColorActive="@color/study_ink"
                app:trackColorInactive="@color/study_glass_divider"
                app:trackHeight="4dp" />
        </LinearLayout>

        <com.gitlab.mudlej.MjPdfReader.study.ui.StrokePreviewView
            android:id="@+id/studyStrokePreview"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/studyMoreColorsButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:text="@string/study_more_highlight_colors"
            android:textColor="@color/study_accent_strong"
            app:backgroundTint="@android:color/transparent"
            app:strokeWidth="0dp" />

        <View style="@style/StudyPanelDivider" />

        <TextView
            style="@style/StudySectionLabel"
            android:text="@string/study_section_pen_buttons" />

        <TextView
            style="@style/StudyFieldLabel"
            android:text="@string/study_primary_button" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/studyPrimaryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/StudyFieldLabel"
            android:text="@string/study_secondary_button" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/studySecondaryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/study_pen_buttons_hint"
            android:textColor="@color/study_muted"
            android:textSize="12sp" />

        <View style="@style/StudyPanelDivider" />

        <TextView
            style="@style/StudySectionLabel"
            android:text="@string/study_section_toolbar" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/studyOrientationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyOrientationHorizontal"
                style="@style/StudySegmentButton"
                android:text="@string/study_layout_horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/studyOrientationVertical"
                style="@style/StudySegmentButton"
                android:text="@string/study_layout_vertical" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/studyStylusOnlySwitch"
            style="@style/StudySwitch"
            android:text="@string/study_stylus_only" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/studyPenAlwaysSwitch"
            style="@style/StudySwitch"
            android:text="@string/study_pen_always_writes" />
    </LinearLayout>
</ScrollView>
