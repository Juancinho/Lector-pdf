    <style name="StudyIconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_glass_tool</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/study_ink</item>
    </style>
    <style name="StudyToolCell">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_glass_tool_cell</item>
        <item name="android:clipChildren">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="StudyToolArt">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="StudySectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/study_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="StudyFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/study_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="StudyPanelDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@color/study_glass_divider</item>
    </style>
    <style name="StudySwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/study_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="thumbTint">@color/study_switch_thumb</item>
        <item name="trackTint">@color/study_switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>
    <style name="StudySegmentButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/study_segment_content</item>
        <item name="iconTint">@color/study_segment_content</item>
        <item name="iconSize">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@color/study_segment_background</item>
        <item name="strokeColor">@color/study_glass_divider</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="StudyChip" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipBackgroundColor">@color/study_segment_background</item>
        <item name="chipStrokeColor">@color/study_glass_divider</item>
        <item name="chipStrokeWidth">0.75dp</item>
        <item name="android:textColor">@color/study_segment_content</item>
        <item name="checkedIconTint">@color/study_segment_content</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
    <style name="StudyToolDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@color/study_glass_divider</item>
    </style>
</resources>
